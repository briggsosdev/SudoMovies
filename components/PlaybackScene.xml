<?xml version="1.0" encoding="utf-8" ?>
<component name="PlaybackScene" extends="Group">
  <interface>
    <field id="movie" type="assocarray" />
    <field id="resumeRec" type="assocarray" />
    <field id="done" type="bool" value="false" />
  </interface>
  <children>
    <Rectangle id="bg" color="0x05070DFF" translation="[0,0]" width="1920" height="1080" />
    <Group id="errorGroup" visible="false">
      <Rectangle id="errorDim" color="0x000000F2" width="1920" height="1080" translation="[0,0]" />
      <Rectangle id="errorGlow" color="0xD4202844" width="780" height="350"
        translation="[570,380]" />
      <Rectangle id="errorPanel" color="0x0B0E17FF" width="760" height="330"
        translation="[580,390]" />
      <Rectangle id="errorEdge" color="0x1F2937FF" width="760" height="2"
        translation="[580,718]" />
