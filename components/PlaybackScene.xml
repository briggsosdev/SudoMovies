        text="Sorry, this stream could not be played."
        visible="false" color="0xE5E7EBFF"
        font="font:MediumSystemFont"
        translation="[600,470]" horizAlign="center" width="720" height="64"
        wrap="true" maxLines="2" />
      <LabelList id="errorList"
        translation="[640,560]"
        itemSize="[640,56]"
        numRows="2"
        focusBitmapUri="pkg:/images/btn_focus.png"
        focusFootprintBitmapUri="pkg:/images/btn_footprint.png"
        color="0x9CA3AFFF"
        focusedColor="0xFFFFFFFF" />
      <Label id="errorHint"
        text="OK retries  •  BACK goes back"
        color="0xE5E7EBFF"
        font="font:MediumSystemFont"
        translation="[600,676]" horizAlign="center" width="720" height="40" />
