        text="BACK cancels this fetch"
        color="0xE5E7EBFF"
        font="font:MediumSystemFont"
        translation="[600,630]" horizAlign="center" width="720" height="40" />
    </Group>
    <Group id="pickerGroup" visible="false">
      <Rectangle id="pickerDim" color="0x000000E6" width="1920" height="1080" translation="[0,0]" />
      <Label id="pickerTitle" text="CHOOSE A SOURCE" color="0xFFFFFFFF"
